# Required for any sign-in to work. Used to sign the session cookie.
# Generate one with:  openssl rand -base64 48
AUTH_SECRET=

# --- Development-only sign-in -------------------------------------------------
# Lets you open the dashboard locally before a real auth provider is connected.
# Ignored completely when NODE_ENV=production. Never put real credentials here.
# Role: super_admin | institution_admin | teacher | student
DEV_AUTH_IDENTIFIER=
DEV_AUTH_PASSWORD=
DEV_AUTH_ROLE=institution_admin
